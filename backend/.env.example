# ── Mode ────────────────────────────────────────────────────────────────────
# DEMO_MODE=1 keeps the original in-memory seed fleet (for sales demos).
# Leave it unset (or 0) with DATABASE_URL present to run against live telemetry.
# BOOTSTRAP_PILOT=1 registers KA01EV1001–1005 on API boot (after migrate).
DEMO_MODE=0
BOOTSTRAP_PILOT=1
DATABASE_URL=postgres://einter:einter@localhost:5432/e_inter

# ── API ─────────────────────────────────────────────────────────────────────
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,https://e-inter.vercel.app
ADMIN_API_TOKEN=change-me            # guards /api/v1/ops/*
DASHBOARD_USERNAME=bluewheelz
DASHBOARD_PASSWORD=bluewheelz
AUTH_SECRET=change-me-dashboard-hmac
GPS_CAN_JOIN_WINDOW_SEC=60

# ── Kafka (ingest worker) ───────────────────────────────────────────────────
KAFKA_BOOTSTRAP=b-1.example:9096,b-2.example:9096,b-3.example:9096
KAFKA_SSL=true
KAFKA_SASL_MECHANISM=scram-sha-512   # plain | scram-sha-256 | scram-sha-512
KAFKA_USERNAME=e-inter-normalizer
KAFKA_PASSWORD=
KAFKA_TOPIC_RAW=intellicar.telemetry.raw.v1
KAFKA_TOPIC_DLQ=intellicar.telemetry.dlq.v1
KAFKA_CONSUMER_GROUP=e-inter-normalizer-v1
KAFKA_CLIENT_ID=e-inter-normalizer
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_HEARTBEAT_INTERVAL_MS=3000
KAFKA_PARTITIONS_CONCURRENT=3
# Set true ONLY for a deliberate replay from the start of the topic.
KAFKA_FROM_BEGINNING=false

# ── Local development with Redpanda ─────────────────────────────────────────
# docker run -d --name redpanda -p 9092:9092 redpandadata/redpanda:latest \
#   redpanda start --overprovisioned --smp 1 --check=false
# KAFKA_BOOTSTRAP=localhost:9092
# KAFKA_SSL=false
# KAFKA_SASL_MECHANISM=
